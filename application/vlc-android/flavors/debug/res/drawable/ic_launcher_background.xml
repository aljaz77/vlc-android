<!--
  Deep blue rather than the usual orange, so this build is obvious at a glance
  next to a stock VLC on the same launcher and the same car screen.

  Overrides the shared drawable for the debug flavour only, and keeps the four
  stop structure of the original: lighter at the top, darkest at the bottom.
  Colours are literal here rather than @color references so that nothing in the
  shared palette has to change.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="54"
                android:endY="108"
                android:startX="54"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#3E6FC4"
                    android:offset="0.0" />
                <item
                    android:color="#2451A8"
                    android:offset="0.54" />
                <item
                    android:color="#17387E"
                    android:offset="0.72" />
                <item
                    android:color="#0C2050"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
